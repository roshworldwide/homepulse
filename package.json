{
  "name": "homepulse",
  "version": "0.1.0",
  "private": true,
  "description": "An MCP server for Alexa+ that lets AI agents run a caregiver's home while making sure only rules the homeowner approved can open a door.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "harness"
  ],
  "scripts": {
    "dev": "npm run dev -w @homepulse/server",
    "start": "npm run start -w @homepulse/server",
    "typecheck": "tsc -p packages/guard && tsc -p apps/server --noEmit",
    "test": "vitest run",
    "test:exhaustive": "vitest run packages/guard/test/exhaustive.test.ts",
    "build:guard": "npm run build -w mcp-streamable-guard",
    "engram:verify": "tsx --conditions=homepulse-source apps/server/src/engram/verify-cli.ts",
    "ring:inject": "tsx --conditions=homepulse-source apps/server/src/ring/injector.ts",
    "ring:check": "tsx --conditions=homepulse-source apps/server/src/ring/check-cli.ts",
    "snapshots": "python3 scripts/make-snapshots.py"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
