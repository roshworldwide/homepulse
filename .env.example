# --- Server ---
PORT=8787
# Bind address. Keep 127.0.0.1 for local development (MCP 2025-11-25 transport guidance).
HOST=127.0.0.1
# When HOST is not loopback: extra Host names to answer to (comma-separated), e.g. the public name
# Ring delivers webhooks to. localhost, this machine's name and its addresses are always allowed.
ALLOWED_HOSTS=
# MCP sessions: idle ones expire (never while a request or stream is open); each role may hold SESSION_MAX.
SESSION_IDLE_MS=1800000
SESSION_MAX=200
# How long a phone whose live stream dropped still counts as reachable while it reconnects.
APPROVER_GRACE_MS=5000
# Behind a load balancer: how many proxy hops to trust for the visitor's address (X-Forwarded-For).
# Leave blank when clients connect directly. The public image sets 1.
TRUST_PROXY=
# Origins allowed to call /mcp and /events. The console dev server and the server itself.
MCP_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8787,http://127.0.0.1:8787
# Where tokens, secrets, signing keys and the Engram database live. Blank = data/ in the repo.
# "memory" keeps everything in memory, so every start is a fresh house (the browser tests use it).
HOMEPULSE_DATA_DIR=

# --- Role tokens (64 hex chars each: openssl rand -hex 32) ---
# Leave blank to have the server generate them on first run into data/tokens.json.
HOMEOWNER_TOKEN=
CAREGIVER_TOKEN=
AGENT_TOKEN=
# Local demo only: lets the console's phone panels fetch the homeowner/caregiver tokens.
# Never enable this on a public deployment.
CONSOLE_EXPOSE_TOKENS=true

# --- Secrets (64 hex chars each). Blank = generated on first run into data/secrets.json ---
CODE_HMAC_SECRET=
RING_HMAC_KEY=

# --- Model provider ---
# bedrock  = Amazon Bedrock Converse API (needs AWS credentials in the usual AWS env/profile)
# offline  = deterministic local stand-in, clearly labelled in the UI. Never used for reported results.
MODEL_PROVIDER=offline
AWS_REGION=us-east-1
# A multimodal model with Converse tool use enabled in your region, e.g. an Anthropic Claude or Amazon Nova model id.
BEDROCK_MODEL_ID=

# --- Ring (Developer Playground) ---
RING_API_BASE=https://api.amazonvision.com
# 30-minute token from the Ring Developer Playground
RING_ACCESS_TOKEN=
RING_DEVICE_ID=

# --- Demo ---
# true = frozen scenario clocks, recorded model fixtures when present, injector snapshots
DEMO_MODE=true
# Scenario clock and night-mode window (22:00-06:00) use this time zone.
# HOMEPULSE_TZ wins over a TZ already set in your shell.
HOMEPULSE_TZ=America/Los_Angeles

# --- Live "try to break in" page (/break-it) ---
# On by default. Each attempt runs in its own fresh in-memory house; only hourly counts are stored.
BREAK_IT=true
BREAK_IT_PER_ADDRESS_PER_HOUR=10
# A cap on all attempts per hour: the real limit on model spend.
BREAK_IT_PER_HOUR=600
BREAK_IT_CONCURRENCY=4
BREAK_IT_TIMEOUT_MS=90000
# Where "/" goes: /console locally, /break-it on a public deployment.
HOME_PAGE=/console
# The page's public address, for its QR code. Blank = taken from the request.
PUBLIC_URL=
